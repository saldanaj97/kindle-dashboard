# Copy to /var/local/dashboard/dashboard.conf, fill in, then chmod 600 it.
# Never put it under /mnt/us: that is the USB drive, readable by any computer
# the Kindle is plugged into (dashboard.sh refuses it). Revoke the token if the
# Kindle is lost.
# Read by dashboard.sh as a shell file. Do not commit the real one.

BASE_URL="https://dashboard.example.com"
SCREEN="trade-plans"
CF_ACCESS_CLIENT_ID="replace-me.access"
CF_ACCESS_CLIENT_SECRET="replace-me"

# Seconds between fetches (default 600).
REFRESH_SECONDS=600
# Where the last good image and log live (default /var/local/dashboard). Keep
# it off /mnt/us too: the cached image shows whatever the screen shows.
CACHE_DIR="/var/local/dashboard"
# Optional: CA bundle for curl --cacert, if the Kindle's curl rejects the TLS cert.
CA_BUNDLE=""
# Optional, untested on device: 1 keeps the screensaver from replacing the image.
PREVENT_SCREENSAVER=0
# awake (default): plain sleep between refreshes; the Kindle stays on and needs
# a charger. suspend: deep sleep between refreshes (Wi-Fi off, RTC wake-up), so
# it can run on battery. Never suspends while a computer is on the USB cable.
SLEEP_MODE=awake
