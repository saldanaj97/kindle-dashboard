{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kindle-dashboard",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // Screens must only be reachable through the custom domain that sits behind
  // Cloudflare Access. A *.workers.dev or preview URL would bypass Access.
  "workers_dev": false,
  "preview_urls": false,
  // Custom domain. Cloudflare Access guards kindle.juansaldana.dev/screen/*.
  "routes": [{ "pattern": "kindle.juansaldana.dev", "custom_domain": true }],
  // Local `wrangler dev` otherwise presents requests as the route's hostname,
  // and the Access dev bypass only applies to local hostnames.
  "dev": { "host": "localhost" },
  "rules": [
    { "type": "Data", "globs": ["**/*.woff"], "fallthrough": true }
  ],
  // Latest payload per source. Local dev and tests simulate KV.
  "kv_namespaces": [
    { "binding": "DASHBOARD_KV", "id": "19f887565c044b75b5ec083daf97ccd3" }
  ],
  // Per-producer ingest secrets. The first deploy passes them with
  // --secrets-file (README, Deploying); rotate later with `wrangler secret put`.
  // Locally they come from .dev.vars (see .dev.vars.example).
  "secrets": {
    "required": ["INGEST_SECRET_TRADING", "INGEST_SECRET_SUMMARY"]
  },
  "vars": {
    "DISPLAY_TZ": "America/New_York",
    // Cloudflare Access: the Worker verifies the Cf-Access-Jwt-Assertion JWT on
    // /screen/* and answers 403 when these are empty or the JWT is invalid.
    // Neither value is a secret.
    "ACCESS_TEAM_DOMAIN": "https://saldana-digital-media.cloudflareaccess.com",
    "ACCESS_AUD": "2bbd833aa6409115ea81f67f50f29c8d83f965a9c634c247dcadd022add5b2c4"
  }
}
