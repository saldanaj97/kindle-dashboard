{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/saldanaj97/kindle-dashboard/contract/market-summary.schema.json",
  "title": "Market summary",
  "description": "Pre-market or end-of-day summary pushed by the summary producer (the AI summary agent, which reads its inputs from the backend).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "as_of",
    "session",
    "headline",
    "points"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "as_of": {
      "description": "Time of the data the summary describes (RFC 3339 with offset), not the time it was written.",
      "type": "string",
      "format": "date-time"
    },
    "market_status": {
      "enum": [
        "pre-market",
        "open",
        "after-hours",
        "closed"
      ]
    },
    "session": {
      "enum": [
        "pre-market",
        "end-of-day"
      ]
    },
    "headline": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "points": {
      "description": "Short bullet points, most important first. Points that don't fit on the screen are counted in a \"+ N more\" line.",
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      }
    },
    "indices": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "symbol",
          "change_pct"
        ],
        "properties": {
          "symbol": {
            "type": "string",
            "pattern": "^[A-Z0-9.^\\-=]{1,6}$"
          },
          "last": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 9999999.99
          },
          "change_pct": {
            "description": "Percent change, e.g. 0.12 for +0.12%.",
            "type": "number",
            "minimum": -99.99,
            "maximum": 99.99
          }
        }
      }
    },
    "plans": {
      "description": "Counts of trade plans by state, for the summary footer.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "watching": {
          "type": "integer",
          "minimum": 0
        },
        "open": {
          "type": "integer",
          "minimum": 0
        },
        "closed_today": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "watch": {
      "description": "Symbols to watch this session.",
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "string",
        "pattern": "^[A-Z0-9.\\-]{1,12}$"
      }
    }
  }
}
